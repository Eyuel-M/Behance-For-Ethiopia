# ─── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
# Leave as-is to run in demo mode (in-memory data, no real DB).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Admin dashboard ───────────────────────────────────────────────────────────
# Set a strong password for the admin panel at /admin
ADMIN_PASSWORD=change-me
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=generate-a-random-32-char-string-here

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
# Without this key, emails are logged to console but not sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The verified sending address in your Resend account
EMAIL_FROM=Hire Ethiopia's Best <noreply@hireethiopiasbest.com>

# ─── Site URL ──────────────────────────────────────────────────────────────────
# Used to construct absolute links in emails and admin (e.g. proposal URLs).
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://hireethiopiasbest.com

# ─── Telegram Bot ──────────────────────────────────────────────────────────────
# Admin notifications: new briefs, new designer applications, etc.
# 1. Create a bot via @BotFather on Telegram → copy the token below
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  to find your chat_id
# Without these, notifications are logged to console only.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxYZ
TELEGRAM_ADMIN_CHAT_ID=your-personal-chat-id-here
